{
  "name": "canary",
  "description": "Context health monitor. Ends every response with [🐦]. When the bird disappears, you know Claude is losing context.",
  "author": {
    "name": "ahmedawaadd",
    "url": "https://github.com/ahmedawaadd"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hooks/canary-check.js\"",
            "timeout": 5,
            "statusMessage": "Checking canary..."
          }
        ]
      }
    ]
  }
}
